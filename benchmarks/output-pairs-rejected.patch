 struct Root {
     profile: usize,
     source: Option<usize>,
+    second_source: Option<usize>,
     impossible: bool,
+}
+
+/// A requested output has exactly one producer. If the first-output roots
+/// cannot occupy this search's worker budget, split each live root by the
+/// second output's producer. These children are disjoint and cover the parent;
+/// no parent completion is published separately from its children.
+fn refine_roots(
+    roots: Vec<Root>,
+    tasks: &[AccountedProfile],
+    inputs: usize,
+    outputs: usize,
+    workers: usize,
+) -> Vec<Root> {
+    let live = roots.iter().filter(|root| !root.impossible).count();
+    if workers <= 1 || outputs < 2 || live >= workers {
+        return roots;
+    }
+    let mut refined: Vec<_> = roots
+        .into_iter()
+        .flat_map(|root| {
+            let sources = if root.impossible || root.source.is_none() {
+                0
+            } else {
+                inputs + tasks[root.profile].profile.node_count() as usize
+            };
+            if sources == 0 {
+                vec![root]
+            } else {
+                (0..sources)
+                    .map(|source| Root {
+                        second_source: Some(source),
+                        ..root
+                    })
+                    .collect()
+            }
+        })
+        .collect();
+    // Visit one child of each parent before its next child, so a large
+    // family cannot occupy the queue ahead of every other first-output root.
+    refined.sort_by_key(|root| root.second_source);
+    refined
 }
 
