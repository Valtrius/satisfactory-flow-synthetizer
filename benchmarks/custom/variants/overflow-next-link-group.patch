+fn overflow_slots(idle_workers: usize) -> usize {
+    idle_workers.saturating_sub(1)
+}
+
+fn try_reserve_overflow_slot(
+    requested_workers: usize,
+    current_task_count: usize,
+    current_finished: &AtomicUsize,
+    overflow_in_flight: &AtomicUsize,
+) -> bool {
+    loop {
+        let current_busy = current_task_count
+            .saturating_sub(current_finished.load(Ordering::Acquire))
+            .min(requested_workers);
+        let idle = requested_workers.saturating_sub(current_busy);
+        let cap = overflow_slots(idle);
+        let in_flight = overflow_in_flight.load(Ordering::Acquire);
+        if in_flight >= cap {
+            return false;
+        }
+        if overflow_in_flight
+            .compare_exchange_weak(in_flight, in_flight + 1, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+        {
+            return true;
+        }
+    }
+}
+
+fn root_output_has_witness(output: &RootTaskOutput) -> bool {
+    match &output.result {
+        RootTaskResult::Search(result) => match result.as_ref() {
+            ProfileSearchResult::Exhausted {
+                best_witness,
+                witnesses,
+                ..
+            }
+            | ProfileSearchResult::Incomplete {
+                best_witness,
+                witnesses,
+                ..
+            } => best_witness.is_some() || !witnesses.is_empty(),
+            ProfileSearchResult::Failed { .. } => false,
+        },
+        RootTaskResult::WorkerPanicked => false,
+    }
+}
