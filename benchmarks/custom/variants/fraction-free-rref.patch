+fn integer_row_from_rationals(row: &[Rational]) -> Vec<BigInt> {
+    let mut lcm = BigInt::one();
+    for value in row {
+        if !value.is_zero() {
+            lcm = lcm.lcm(value.denominator());
+        }
+    }
+    row.iter()
+        .map(|value| {
+            if value.is_zero() {
+                BigInt::zero()
+            } else if value.denominator() == &lcm {
+                value.numerator().clone()
+            } else {
+                value.numerator() * (&lcm / value.denominator())
+            }
+        })
+        .collect()
+}
+
+fn gcd_reduce_integers(row: &mut [BigInt]) {
+    let mut gcd = BigInt::zero();
+    for value in row.iter() {
+        if value.is_zero() {
+            continue;
+        }
+        gcd = if gcd.is_zero() {
+            value.abs()
+        } else {
+            gcd.gcd(value)
+        };
+        if gcd.is_one() {
+            return;
+        }
+    }
+    if gcd.is_zero() || gcd.is_one() {
+        return;
+    }
+    for value in row {
+        if !value.is_zero() {
+            *value /= &gcd;
+        }
+    }
+}
+
+fn unit_pivot_rational_row(row: Vec<BigInt>, variable_count: usize) -> Vec<Rational> {
+    let pivot = row[..variable_count]
+        .iter()
+        .find(|value| !value.is_zero())
+        .expect("nonzero variable support")
+        .clone();
+    if pivot.is_one() {
+        return row.into_iter().map(Rational::from).collect();
+    }
+    let scale = Rational::from(pivot);
+    row.into_iter()
+        .map(|value| {
+            if value.is_zero() {
+                Rational::zero()
+            } else {
+                &Rational::from(value) / &scale
+            }
+        })
+        .collect()
+}
+
+fn integer_rows_to_canonical(ints: Vec<Vec<BigInt>>, variable_count: usize) -> Vec<Vec<Rational>> {
+    let inconsistent = ints.iter().any(|row| {
+        row[..variable_count].iter().all(Zero::is_zero) && !row[variable_count].is_zero()
+    });
+    if inconsistent {
+        let mut contradiction = vec![Rational::zero(); variable_count + 1];
+        contradiction[variable_count] = Rational::one();
+        return vec![contradiction];
+    }
+    let mut rows = ints
+        .into_iter()
+        .filter(|row| row[..variable_count].iter().any(|value| !value.is_zero()))
+        .map(|mut row| {
+            gcd_reduce_integers(&mut row);
+            unit_pivot_rational_row(row, variable_count)
+        })
+        .collect::<Vec<_>>();
+    rows.reverse();
+    rows
+}
+
+fn eliminate_integer_row(
+    row: &mut [BigInt],
+    column: usize,
+    pivot: &BigInt,
+    nonzero: &[(usize, BigInt)],
+    mut profile: Option<&mut hotspot_profile::RrefProfile>,
+) {
+    let factor = std::mem::replace(&mut row[column], BigInt::zero());
+    let unit_factor = factor.is_one();
+    let negative_unit_factor = factor.is_negative() && factor.magnitude().is_one();
+    let pivot_is_one = pivot.is_one();
+    if let Some(profile) = profile.as_mut() {
+        profile.eliminated_rows += 1;
+        profile.unit_factors += u64::from(unit_factor);
+        profile.negative_unit_factors += u64::from(negative_unit_factor);
+        profile.integer_factors += 1;
+        profile.observe(&Rational::from(factor.clone()));
+    }
+    if !pivot_is_one {
+        for (index, value) in row.iter_mut().enumerate() {
+            if index != column && !value.is_zero() {
+                *value *= pivot;
+            }
+        }
+    }
+    for &(index, ref pivot_value) in nonzero {
+        if let Some(profile) = profile.as_mut() {
+            profile.coefficient_updates += 1;
+            profile.unit_factor_updates += u64::from(unit_factor);
+            profile.negative_unit_factor_updates += u64::from(negative_unit_factor);
+            profile.zero_destinations += u64::from(row[index].is_zero());
+            profile.unit_pivot_updates += u64::from(pivot_value.is_one());
+            profile.integer_pivot_updates += 1;
+            profile.observe(&Rational::from(row[index].clone()));
+            profile.observe(&Rational::from(pivot_value.clone()));
+        }
+        row[index] = if pivot_is_one && unit_factor {
+            &row[index] - pivot_value
+        } else if pivot_is_one && negative_unit_factor {
+            &row[index] + pivot_value
+        } else {
+            &row[index] - &factor * pivot_value
+        };
+        if let Some(profile) = profile.as_mut() {
+            profile.observe(&Rational::from(row[index].clone()));
+        }
+    }
+}
