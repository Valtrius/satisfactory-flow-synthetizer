+                    .saturating_mul(std::mem::size_of::<NodeId>()),
+            )
+            .saturating_add(
+                entry
+                    .known_producers
+                    .len()
+                    .saturating_mul(std::mem::size_of::<(ProducerPortRef, Rational)>()),
+            )
+            .saturating_add(
+                entry
+                    .known_consumers
+                    .len()
+                    .saturating_mul(std::mem::size_of::<(ConsumerPortRef, Rational)>()),
+            )
+            .saturating_add(std::mem::size_of::<CachedOpenSccSummary>())
+            .saturating_add(
+                entry
+                    .summary
+                    .known_values
+                    .len()
+                    .saturating_mul(std::mem::size_of::<CachedKnownValue>()),
