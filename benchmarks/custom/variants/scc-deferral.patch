+                fingerprint_producer_owner(topology, &parts.node_types, *port),
+                producer_fingerprint_index(*port),
+                value.clone(),
+            )
+        })
+        .collect::<Vec<_>>();
+    known_producer_descriptors.sort();
+    let mut known_consumer_descriptors = known_consumers
+        .iter()
+        .map(|(port, value)| {
