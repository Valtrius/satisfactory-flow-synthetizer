+fn relabel_scc_endpoint(
+    endpoint: CanonicalFlowEndpoint,
+    producer_relabeling: &BTreeMap<ProducerPortRef, ProducerPortRef>,
+    consumer_relabeling: &BTreeMap<ConsumerPortRef, ConsumerPortRef>,
+) -> Result<CanonicalFlowEndpoint, ProfileSearchError> {
+    match endpoint {
+        CanonicalFlowEndpoint::Producer(raw) => producer_relabeling
+            .get(&raw)
+            .copied()
+            .map(CanonicalFlowEndpoint::Producer)
+            .ok_or_else(|| {
+                ProfileSearchError::Scc(
+                    "deferred SCC deduction omitted a producer relabeling".to_owned(),
+                )
+            }),
+        CanonicalFlowEndpoint::Consumer(raw) => consumer_relabeling
+            .get(&raw)
+            .copied()
+            .map(CanonicalFlowEndpoint::Consumer)
+            .ok_or_else(|| {
+                ProfileSearchError::Scc(
+                    "deferred SCC deduction omitted a consumer relabeling".to_owned(),
+                )
+            }),
+    }
+}
