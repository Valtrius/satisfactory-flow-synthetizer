+    let mut parts = fingerprint_parts(topology, cancel)?;
+    let mut region_descriptors = region_nodes
+        .iter()
+        .map(|node| {
+            let node_type = parts.node_types[node];
+            let mut incidents = parts.node_incidents.remove(node).unwrap_or_default();
+            incidents.sort();
+            (node_type, incidents)
+        })
+        .collect::<Vec<_>>();
