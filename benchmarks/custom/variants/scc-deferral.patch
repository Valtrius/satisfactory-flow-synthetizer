+fn deferred_scc_entry_bytes(entry: &DeferredSccEntry) -> u64 {
+    let rational_payload = entry
+        .snapshot
+        .links
+        .iter()
+        .filter_map(|link| link.flow.as_ref())
+        .map(rational_payload_bytes)
+        .chain(
+            entry
+                .known_producers
+                .values()
+                .chain(entry.known_consumers.values())
+                .map(rational_payload_bytes),
+        )
+        .chain(
+            entry
+                .summary
+                .known_values
+                .iter()
+                .map(|deduction| rational_payload_bytes(&deduction.value)),
+        )
+        .chain(
+            entry
+                .summary
+                .homogeneous_ratios
+                .iter()
+                .map(|deduction| rational_payload_bytes(&deduction.factor)),
+        )
+        .fold(0_usize, usize::saturating_add);
+    u64::try_from(
+        std::mem::size_of::<SccFingerprint>()
+            .saturating_add(std::mem::size_of::<DeferredSccEntry>())
+            .saturating_add(
+                entry
