+fn relabel_deferred_scc_summary(
+    summary: CachedOpenSccSummary,
+    producer_relabeling: &BTreeMap<ProducerPortRef, ProducerPortRef>,
+    consumer_relabeling: &BTreeMap<ConsumerPortRef, ConsumerPortRef>,
+) -> Result<CachedOpenSccSummary, ProfileSearchError> {
+    let mut known_values = summary
+        .known_values
+        .into_iter()
+        .map(|deduction| {
+            Ok(CachedKnownValue {
+                variable: relabel_scc_endpoint(
+                    deduction.variable,
+                    producer_relabeling,
+                    consumer_relabeling,
+                )?,
+                value: deduction.value,
+            })
+        })
+        .collect::<Result<Vec<_>, ProfileSearchError>>()?;
+    known_values
+        .sort_by(|left, right| (&left.variable, &left.value).cmp(&(&right.variable, &right.value)));
+    let mut homogeneous_ratios = summary
+        .homogeneous_ratios
+        .into_iter()
+        .map(|deduction| {
+            Ok(CachedHomogeneousRatio {
+                lhs: relabel_scc_endpoint(deduction.lhs, producer_relabeling, consumer_relabeling)?,
+                rhs: relabel_scc_endpoint(deduction.rhs, producer_relabeling, consumer_relabeling)?,
+                factor: deduction.factor,
+            })
+        })
+        .collect::<Result<Vec<_>, ProfileSearchError>>()?;
+    homogeneous_ratios.sort_by(|left, right| {
+        (&left.lhs, &left.rhs, &left.factor).cmp(&(&right.lhs, &right.rhs, &right.factor))
+    });
+    Ok(CachedOpenSccSummary {
+        consistency: summary.consistency,
+        coefficient_rank: summary.coefficient_rank,
+        augmented_rank: summary.augmented_rank,
+        variable_count: summary.variable_count,
+        known_values,
+        homogeneous_ratios,
+    })
+}
