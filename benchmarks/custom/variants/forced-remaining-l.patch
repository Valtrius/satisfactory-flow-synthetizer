+    /// Exact minimum additional operator links still required from leftover node
+    /// ports after using every remaining terminal. Inventory cannot add terminals.
+    #[must_use]
+    pub fn remaining_operator_link_lower_bound(&self) -> u32 {
+        let remaining = self.remaining.as_node_profile();
+        let Some(inventory_producers) = inventory_producer_ports(remaining) else {
+            return 0;
+        };
+        let Some(inventory_consumers) = inventory_consumer_ports(remaining) else {
+            return 0;
+        };
+        let open_producers = u32::try_from(
+            self.producer_ports
+                .iter()
+                .filter(|(reference, port)| {
+                    port.connection.is_none() && matches!(reference, ProducerPortRef::Node { .. })
+                })
+                .count(),
+        )
+        .unwrap_or(0);
+        let open_consumers = u32::try_from(
+            self.consumer_ports
+                .iter()
+                .filter(|(reference, port)| {
+                    port.connection.is_none() && matches!(reference, ConsumerPortRef::Node { .. })
+                })
+                .count(),
+        )
+        .unwrap_or(0);
+        let open_terminal_producers = u32::try_from(
+            self.producer_ports
+                .iter()
+                .filter(|(reference, port)| {
+                    port.connection.is_none() && matches!(reference, ProducerPortRef::Input(_))
+                })
+                .count(),
+        )
+        .unwrap_or(0);
+        let open_terminal_consumers = u32::try_from(
+            self.consumer_ports
+                .iter()
+                .filter(|(reference, port)| {
+                    port.connection.is_none()
+                        && matches!(
+                            reference,
+                            ConsumerPortRef::Output(_) | ConsumerPortRef::Discard(_)
+                        )
+                })
+                .count(),
+        )
+        .unwrap_or(0);
+        let node_producers = open_producers.saturating_add(inventory_producers);
+        let node_consumers = open_consumers.saturating_add(inventory_consumers);
+        node_producers
+            .saturating_sub(open_terminal_consumers)
+            .max(node_consumers.saturating_sub(open_terminal_producers))
+    }
+
