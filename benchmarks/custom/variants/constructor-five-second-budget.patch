+
+struct ConstructionBudget<'a> {
+    cancel: &'a AtomicBool,
+    deadline: Option<Instant>,
+    expired: bool,
+}
+
+impl<'a> ConstructionBudget<'a> {
+    fn new(cancel: &'a AtomicBool, limit: Option<Duration>) -> Self {
+        Self {
+            cancel,
+            deadline: limit.map(|limit| Instant::now() + limit),
+            expired: false,
+        }
+    }
+
+    fn stopped(&mut self) -> bool {
+        self.expired |= self
+            .deadline
+            .is_some_and(|deadline| Instant::now() >= deadline);
+        self.expired || self.cancel.load(Ordering::Relaxed)
     }
 }
 
